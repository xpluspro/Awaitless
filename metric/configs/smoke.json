{
  "schema_version": 1,
  "name": "local-smoke",
  "description": "Fast harness validation only; not publishable evidence.",
  "trials": 1,
  "seed": 20260810,
  "arms": ["tmux_plain", "tmux_wrapped", "awaitless"],
  "poll_interval_seconds": 0.05,
  "wait_interrupt_after_seconds": 0.08,
  "log_tail_lines": 50,
