    "failure": {
      "duration_seconds": 0.25,
      "line_count": 5,
      "line_bytes": 128,
      "exit_codes": [1, 7, 124]
    },
    "large_log": {
      "duration_seconds": 0.1,
      "line_count": 4096,
      "line_bytes": 256,
      "exit_codes": [0]
    },
    "recovery": {
      "duration_seconds": 0.5,
      "line_count": 10,
      "line_bytes": 128,
      "exit_codes": [0]
    },
    "cancel_tree": {
      "duration_seconds": 30.0,
      "line_count": 1,
      "line_bytes": 128,
      "exit_codes": [0],
      "cancel_after_seconds": 0.1
    }
  }
}
